# /etc/contextd/contextd.env  — права 640, владелец root:<сервисный пользователь>
# Сгенерировать токен:  python3 -c 'import secrets;print(secrets.token_urlsafe(32))'

CONTEXTD_DB=/srv/contextd/context.db

# Если пусто — авторизация отключена. На сервере так нельзя: порт слушает 0.0.0.0.
CONTEXTD_TOKEN=CHANGE_ME

# Бюджет выдачи по умолчанию, в «токенах» (len/3.2)
CONTEXTD_BUDGET=800

# Эмбеддер, OpenAI-совместимый /v1/embeddings. Пусто — работаем только на FTS.
CONTEXTD_EMBED_URL=http://127.0.0.1:8081/v1/embeddings
CONTEXTD_EMBED_MODEL=bge-m3
CONTEXTD_EMBED_DIM=1024

# Веса каналов в RRF. Дефолт 0.3/1.0 подобран замерами (docs/benchmarks.md).
CONTEXTD_FTS_W=0.3
CONTEXTD_VEC_W=1.0

# Необязательные бэкенды
# CONTEXTD_RERANK_URL=http://127.0.0.1:8083/rerank
# CONTEXTD_QDRANT_URL=http://127.0.0.1:6333
