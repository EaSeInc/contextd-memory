[Unit]
Description=contextd local context/memory service
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/opt/contextd
EnvironmentFile=/etc/contextd/contextd.env
ExecStart=/opt/contextd/.venv/bin/uvicorn contextd:app --host 0.0.0.0 --port 8090 --no-access-log
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
